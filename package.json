    "react-router-dom": "^6.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.2",
    "oxlint": "1.90.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^5.3.4",
