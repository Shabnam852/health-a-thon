# Supply-chain safety: install only versions published at least 14 days ago, for every
# package in the tree. A brand-new release (where most hijacked versions sit) waits two weeks.
# To take an urgent security fix sooner, add that package to min-release-age-exclude.
min-release-age=14

# No package needs an install script today. Blocking them keeps a hijacked package from
# running code during npm ci or the Vercel build, where the deploy token is in the environment.
ignore-scripts=true
