# Server-side only. Copy to .env (git-ignored) and set the same names in Vercel.
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# Neon Postgres for the shared demo data (/api/state). From the Vercel Neon integration; the
# deployed server reads DATABASE_URL, then STORAGE_URL.
DATABASE_URL=
# `npm run dev` never uses DATABASE_URL, so local work can't change the live demo. Set this to a
# separate Neon branch to test against a real database; leave it empty to keep the data in memory.
DEV_DATABASE_URL=
