classDiagram
  accTitle: Actions on a referral
  accDescr: A referral has lifecycle actions and owns barriers, a transport record and a follow-up plan, each with its own actions.
  class Referral {
    +id
    +status
    +priority
    +toFacility
    +acknowledge()
    +reject()
    +recordPatientChoice()
    +recordGoingElsewhere()
    +confirmArrival()
    +recordOutcome()
    +recordContact()
  }
  class Barrier {
    +category
    +status
    +identify()
    +resolve()
  }
  class Transport {
    +status
    +driver
    +eta
    +dispatch()
    +recordPickup()
    +recordFailure()
  }
  class FollowUpPlan {
    +status
    +tasks
    +completeTask()
  }
  Referral "1" *-- "many" Barrier
  Referral "1" *-- "0..1" Transport
  Referral "1" *-- "0..1" FollowUpPlan
